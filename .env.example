# IndusTrace AI Environment Configuration Template
PORT=8000
HOST=127.0.0.1
# Absolute SQLite file URL (recommended on Windows) or relative to backend/
DATABASE_URL=sqlite:///backend/data/industrace.db
# On Render persistent disk: DATABASE_URL=sqlite:////var/data/industrace.db
ENVIRONMENT=development
# Required JWT secret key for signing authentication tokens
JWT_SECRET=replace_with_a_secure_random_secret_in_production
# Default passwords for development seeding (ignored in production)
DEMO_USER_PASSWORD=replace_with_secure_demo_password
PLATFORM_OWNER_PASSWORD=replace_with_secure_platform_owner_password
# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173
